# Configuração local da API
PORT=3000
SERVICE_NAME=tiktok-auto-publisher-api

# URL de conexão PostgreSQL. Exemplo apenas local:
# DATABASE_URL=postgresql://publisher:senha@localhost:5432/tiktok_publisher
# Nunca coloque credenciais reais neste arquivo versionado ou no Git.

# Armazenamento local (use volume persistente em hospedagem)
MEDIA_STORAGE_DIR=./var/media
# Limite por vídeo: 500 MiB
MAX_UPLOAD_BYTES=524288000

# Agendador de limpeza: permanece desligado até validação explícita.
STORAGE_CLEANUP_SCHEDULER_ENABLED=false
STORAGE_CLEANUP_INTERVAL_MS=900000
STORAGE_CLEANUP_BATCH_SIZE=25
